  "construction": {
    "description": "The Hampton Construction door combines the classic shaker style with the benefits of engineered timber. Featuring a finger-jointed and laminated timber frame with a 9mm inlay, this door offers enhanced stability and durability, making it a reliable and timeless choice for Hampton-inspired spaces.\nCode: HAM\n",
    "image": {
      "_type": "image",
      "alt": "A diagram showing the Hampton Construction’s finger-jointed and laminated timber frame with a 9mm inlay, emphasising its engineered stability and classic shaker style for Hampton-inspired designs",
      "asset": {
        "_ref": "image-58384757856763b53d56f96fdf3394b4fdeae2a1-522x522-jpg",
        "_type": "reference"
      }
    },
    "title": "Hampton Construction"
  },
