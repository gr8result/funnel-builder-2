  "doorConstructionDownload": "/download?file=%2Fs%2Ffiles%2F1%2F0731%2F6868%2F3252%2Ffiles%2FConstruction_Page_from_HUME-Catalogue-2022_10_20bf301e-749b-478d-bd13-ef45eabc5910.pdf",
  "faqs": [
    {
      "_key": "3f6b71908280",
      "description": [
        {
          "_key": "02635c532230",
          "_type": "block",
          "children": [
            {
              "_key": "e744f11eec160",
              "_type": "span",
              "marks": [],
              "text": "We do not sell directly to the public. However, Hume Doors are available through our network of resellers and hardware stores. Use our store locator to find your nearest stockist."
            }
          ],
          "markDefs": [],
          "style": "normal"
        }
      ],
      "title": "Can I buy Hume Doors directly from you?"
    },
    {
      "_key": "10e5141d283c",
      "description": [
        {
          "_key": "2fbe5b01022d",
          "_type": "block",
          "children": [
            {
              "_key": "0c6d1716af8e0",
              "_type": "span",
              "marks": [],
              "text": "Yes, selected products are available with custom designs and/or special sizes. To view available options, visit the webpage of your chosen product and check the Sizes and Weight tab for details."
            }
          ],
          "markDefs": [],
          "style": "normal"
        }
      ],
      "title": "Do you make custom doors?"
    },
    {
      "_key": "330ee0908a22",
      "description": [
        {
          "_key": "5fc5788319a6",
          "_type": "block",
          "children": [
            {
              "_key": "91c9f192a8100",
              "_type": "span",
              "marks": [],
              "text": "Hume Doors does not offer painting or staining services. For DIY tips, please visit the Support Section on our website. Alternatively, a professional painter or decorator can help achieve your desired finish."
            }
          ],
          "markDefs": [],
          "style": "normal"
        }
      ],
      "title": "Do you paint or stain doors?"
    },
    {
      "_key": "d834f782dcd9",
      "description": [
        {
          "_key": "c0df961bf792",
          "_type": "block",
          "children": [
            {
              "_key": "5f11466d82710",
              "_type": "span",
              "marks": [],
              "text": "We do not offer installation services. However, you can find helpful DIY videos in the DIY section of our website. For professional installation, consider contacting a qualified carpenter, or ask your local stockist, as some offer installation services."
            }
          ],
          "markDefs": [],
          "style": "normal"
        }
      ],
      "title": "Do you provide an installation service?"
    },
    {
      "_key": "7a5c6ea9567c",
      "description": [
        {
          "_key": "5f6ec0e6ea43",
          "_type": "block",
          "children": [
            {
              "_key": "75b9117f3f830",
              "_type": "span",
              "marks": [],
              "text": "To view pricing, select a door model from one of our ranges, customise your options (door face, glass, etc.), and choose your state. The price will then be displayed. For door systems or other products, you can download the relevant document directly from the product page on our website. Alternatively, visit a local Hume Doors stockist."
            }
          ],
          "markDefs": [],
          "style": "normal"
        }
      ],
      "title": "How can I get pricing for Hume Doors?"
    },
    {
      "_key": "395a9934f030",
      "description": [
        {
          "_key": "542754c11599",
          "_type": "block",
          "children": [
            {
              "_key": "aaef280f426d0",
              "_type": "span",
              "marks": [],
              "text": "Lead times vary depending on product type and location. Manufacturing typically takes 3–20 business days, depending on the complexity of the door. Customisations such as glazing, special sizes, veneers, and additions (e.g., rebating, vent openings) may extend the production time."
            }
          ],
          "markDefs": [],
          "style": "normal"
        }
      ],
      "title": "What is the lead time for delivery?"
    },
    {
      "_key": "534e7270fe83",
      "description": [
        {
          "_key": "9ef9971dc1cc",
          "_type": "block",
          "children": [
            {
              "_key": "aca9d3c688b60",
              "_type": "span",
              "marks": [],
              "text": "You can purchase Hume Doors from your local hardware store or authorised reseller. Use our store locator to find the nearest stockist."
            }
          ],
          "markDefs": [],
          "style": "normal"
        }
      ],
      "title": "Where can I purchase Hume Doors?"
    }
  ],
